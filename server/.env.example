# Google Gemini API
GEMINI_API_KEY=sua_chave_api_aqui

# Servidor
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Modelos (em ordem de prioridade)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-pro-latest

# Rate Limiting
MAX_REQUESTS_PER_DAY=50

# Timeouts (em segundos)
REQUEST_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# CORS
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:8000